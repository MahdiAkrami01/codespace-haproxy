{
  "name": "HAProxy",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "haproxy",
  "shutdownAction": "stopContainer",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--privileged"
  ],

  "customizations": {
    "codespaces": {
      "openFiles": [
        "config/haproxy.cfg"
      ]
    }
  }
}
